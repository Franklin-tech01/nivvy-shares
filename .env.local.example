# Neon connection string (server-only, never NEXT_PUBLIC_)
DATABASE_URL=

# Better Auth. Generate a secret with:  npx @better-auth/cli secret
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

NEXT_PUBLIC_COMMUNITY_GROUP_URL=
NEXT_PUBLIC_COMMUNITY_CHANNEL_URL=

# Optional support links
NEXT_PUBLIC_SUPPORT_WHATSAPP_URL=
NEXT_PUBLIC_SUPPORT_EMAIL=

# Korapay (server-only). Used for deposits via hosted checkout + webhook.
# https://developers.korapay.com — dashboard has separate test/live key pairs.
KORAPAY_SECRET_KEY=
# Not used yet (no inline widget or direct card charge implemented).
KORAPAY_PUBLIC_KEY=
KORAPAY_ENCRYPTION_KEY=

# OTPay (server-only). Used for withdrawal payouts — see /admin/withdrawals.
# https://otpay.ng
OTPAY_API_KEY=
OTPAY_SECRET_KEY=
OTPAY_BUSINESS_CODE=
